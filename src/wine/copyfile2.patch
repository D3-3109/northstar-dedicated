From 1e348427994e5675ded3b1540a15a8af85cc8ebc Mon Sep 17 00:00:00 2001
From: Kartavya Vashishtha <sendtokartavya@gmail.com>
Date: Fri, 16 Feb 2024 19:14:22 -0500
Subject: [PATCH] kernelbase: Implement CopyFile2().

Backport the API entry point to Wine 7.0. Its existing CopyFileExW
implementation provides the required file-copy behavior.

---
 dlls/kernel32/kernel32.spec     |  1 +
 dlls/kernelbase/file.c          | 16 ++++++++++++++++
 dlls/kernelbase/kernelbase.spec |  2 +-
 3 files changed, 18 insertions(+), 1 deletion(-)

diff --git a/dlls/kernel32/kernel32.spec b/dlls/kernel32/kernel32.spec
--- a/dlls/kernel32/kernel32.spec
+++ b/dlls/kernel32/kernel32.spec
@@ -256,6 +256,7 @@
 @ stdcall -import ConvertThreadToFiberEx(ptr long)
 @ stdcall ConvertToGlobalHandle(long)
 @ stdcall -import -arch=i386,x86_64 CopyContext(ptr long ptr)
+@ stdcall -import CopyFile2(wstr wstr ptr)
 @ stdcall CopyFileA(str str long)
 @ stdcall CopyFileExA (str str ptr ptr ptr long)
 @ stdcall -import CopyFileExW(wstr wstr ptr ptr ptr long)
diff --git a/dlls/kernelbase/file.c b/dlls/kernelbase/file.c
--- a/dlls/kernelbase/file.c
+++ b/dlls/kernelbase/file.c
@@ -584,6 +584,22 @@ BOOL WINAPI CopyFileExW( const WCHAR *source, const WCHAR *dest, LPPROGRESS_ROUT
     return ret;
 }
 
+/***********************************************************************
+ *	CopyFile2   (kernelbase.@)
+ */
+HRESULT WINAPI CopyFile2( const WCHAR *source, const WCHAR *dest, COPYFILE2_EXTENDED_PARAMETERS *params )
+{
+    DWORD flags = params ? params->dwCopyFlags : 0;
+
+    if (params && params->pfCancel)
+        FIXME("pfCancel is not supported\n");
+    if (params && params->pProgressRoutine)
+        FIXME("PCOPYFILE2_PROGRESS_ROUTINE is not supported\n");
+
+    return CopyFileExW( source, dest, NULL, NULL, NULL, flags )
+        ? S_OK : HRESULT_FROM_WIN32( GetLastError() );
+}
+
 
 /**************************************************************************
  *	CopyFileW   (kernelbase.@)
diff --git a/dlls/kernelbase/kernelbase.spec b/dlls/kernelbase/kernelbase.spec
--- a/dlls/kernelbase/kernelbase.spec
+++ b/dlls/kernelbase/kernelbase.spec
@@ -167,7 +167,7 @@
 @ stdcall ConvertThreadToFiberEx(ptr long)
 @ stdcall ConvertToAutoInheritPrivateObjectSecurity(ptr ptr ptr ptr long ptr)
 @ stdcall -arch=i386,x86_64 CopyContext(ptr long ptr)
-# @ stub CopyFile2
+@ stdcall CopyFile2(wstr wstr ptr)
 @ stdcall CopyFileExW(wstr wstr ptr ptr ptr long)
 @ stdcall CopyFileW(wstr wstr long)
 @ stdcall -arch=x86_64 CopyMemoryNonTemporal(ptr ptr long) ntdll.RtlCopyMemoryNonTemporal
-- 
2.43.0
