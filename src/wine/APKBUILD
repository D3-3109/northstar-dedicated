803b002e18365488fafd1fb8dabe52b6b6f6e779bb6c730e6bed43f568d4099fb98c71cfb644dd2bd072d3a9fb351f37db413a99fe52785ac3a7d20eef80a979  mingw-w64-ucrt.patch
"
