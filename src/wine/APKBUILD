# Maintainer: pg9182 <96569817+pg9182@users.noreply.github.com>
pkgname=northstar-dedicated-wine
pkgver=11.14
pkgrel=0
pkgdesc="Patched Wine build for the Northstar dedicated server"

url="https://www.winehq.org"
license="LGPL-2.0-or-later"

arch="x86_64"
provides="wine=${pkgver}"
subpackages="$pkgname-dev $pkgname-doc"
depends_dev="$pkgname perl"
makedepends="autoconf automake bison flex gnutls-dev libxi-dev mingw-w64-gcc mingw-w64-binutils linux-headers"

options="textrels !check"
somask="ntdll.so win32u.so"
source="https://dl.winehq.org/wine/source/11.x/wine-$pkgver.tar.xz
	rpath.patch
	mingw-w64-ucrt.patch
	"

builddir="$srcdir/wine-$pkgver"

build() {
	local _win64 _no_pie
	case "$CARCH" in
		x86_64) _win64=--enable-win64;;
		x86) _no_pie="-no-pie";;
	esac
	export CROSSCFLAGS="${CROSSCFLAGS:--g -O2} -D__MSVCRT_VERSION__=0x700"
	# The Wine 7 component-pruning list must be regenerated after runtime tracing on Wine 11.
	# First pass: unused interactive tools from the Wine 11 runtime trace.
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--without-alsa \
		--without-capi \
		--without-coreaudio \
