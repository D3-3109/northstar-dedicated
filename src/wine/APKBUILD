package() {
	make DESTDIR="$pkgdir" install

	find "$pkgdir"/usr/lib/wine/x86_64-windows -type f \
		\( -name '*.acm' -o -name '*.ax' -o -name '*.com' -o -name '*.cpl' \
		-o -name '*.dll' -o -name '*.drv' -o -name '*.ds' -o -name '*.exe' \
		-o -name '*.msstyles' -o -name '*.ocx' -o -name '*.sys' \) \
		-exec x86_64-w64-mingw32-strip --strip-unneeded {} +
}

dev() {
	default_dev

	install -d "$subpkgdir"/usr/bin

	local file
	for file in widl wmc wrc winebuild winedump function_grep.pl \
		 winedbg winemaker winegcc winecpp wineg++
	do
		mv "$pkgdir"/usr/bin/$file "$subpkgdir"/usr/bin/ || true
	done
}

doc() {
	default_doc
	rm -fr "$subpkgdir"/usr/share/man/*.UTF-8
}

