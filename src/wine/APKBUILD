		--disable-mswsock --disable-msxml --disable-msxml2 --disable-msxml3 --disable-msxml4 --disable-msxml6 --disable-mtxdm \
		--disable-nddeapi --disable-netcfgx --disable-netprofm --disable-ninput --disable-notepad --disable-npmshtml --disable-npptools \
		--disable-ntdsapi --disable-ntprint --disable-objsel --disable-odbc32 --disable-odbcbcp --disable-odbccp32 --disable-odbccu32 \
		--disable-oleacc --disable-olecli32 --disable-oledlg --disable-olepro32 --disable-olesvr32 --disable-olethk32 \
		--disable-opcservices --disable-opencl --disable-packager --disable-pdh --disable-photometadatahandler --disable-pidgen \
		--disable-powrprof --disable-presentationfontcache --disable-printui --disable-prntvpt --disable-pstorec --disable-pwrshplugin \
		--disable-qasf --disable-qdvd --disable-qmgr --disable-qmgrprxy --disable-quartz --disable-query --disable-qwave \
		--disable-rasapi32 --disable-rasdlg --disable-resutils --disable-riched20 --disable-riched32 --disable-rsabase --disable-rstrtmgr \
